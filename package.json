{
  "name": "dsh-restart-and-update",
  "version": "1.1.0",
  "type": "module",
  "description": "Restart DeepSeek Harness, update its plugins, and keep the window where you left it: verified updates with publish dates, plus a restart that survives the Windows console trap. · 侧栏一键更新插件与重启 Harness，并记住窗口位置。",
  "icon": "./icon.svg",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "plugin-manager",
    "cordis",
    "window",
    "koffi"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolacmeo/dsh-restart-and-update.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/dolacmeo/dsh-restart-and-update#readme",
  "bugs": {
    "url": "https://github.com/dolacmeo/dsh-restart-and-update/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/window-state.test.mjs"
  }
}
